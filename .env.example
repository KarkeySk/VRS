VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Public user app URL used in Supabase verification emails.
# Use your deployed frontend URL here so email links work from any computer.
VITE_USER_APP_URL=https://your-deployed-user-app.com

# Optional: set this only if the verification path is different.
# VITE_AUTH_REDIRECT_URL=https://your-deployed-user-app.com/auth/verify
